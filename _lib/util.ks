    // *- Bit operations
    // #region

    // BitMaskToHex :: _bitMask<string> -> hexVal<string>
    // Takes a 4, 8, or 16 bit mask and converts it to hex
    global function BitMaskToHex
    {
        parameter _bitMask.

        local hexVal to "".

        return hexVal.
    }

