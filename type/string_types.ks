@LazyGlobal off.

//  Establishes the base types in common use across multiple libraries and scripts

// Types
// #region

    // String types
    global StringUnits to lexicon(
        "m", 1,
        "Km", 100000,
        "cm", 0.1,
        "Mm", 1000000,
        "mmm", 0.01,
        "Gm", 1000000000
    ).

// #endregion

